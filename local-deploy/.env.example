# --- Docs-repo local deployment of cat-factory (no-auth dev mode) ------------------
#
# This is a purpose-built, throwaway configuration used to boot cat-factory locally so
# the documentation site can capture UI screenshots. It runs the product with the auth
# gate open (dev-open) and NO GitHub/model credentials, which is enough to render every
# screen the docs need. It is NOT a template for a real install — for that, see
# cat-factory's own deploy/local/.env.example and the docs under /deploy.
#
# scripts/start.mjs copies this file to .env on first run and fills in the two crypto
# secrets for you (AUTH_SESSION_SECRET + ENCRYPTION_KEY). Commit .env.example, never .env.

# Postgres from docker-compose.yml. Note port 5433 (not the usual 5432) so this runs
# alongside a real local checkout without clashing. Use 127.0.0.1 rather than localhost:
# on Windows localhost can resolve to IPv6 (::1) first and stall the connection.
DATABASE_URL=postgres://cat:cat@127.0.0.1:5433/catfactory

# The JSON API port. The frontend's apiBase defaults to http://localhost:8787.
PORT=8787

# Marks this as a development deployment. With ENVIRONMENT=local and no explicit
# CORS_ALLOWED_ORIGINS, the API reflects any browser origin, so the Nuxt dev server can
# call it whatever port it runs on. (Outside dev the API default-denies CORS.)
ENVIRONMENT=local

# Bind to loopback only. The gate is open below, so we keep the surface on this machine.
HOST=127.0.0.1

# No-auth dev mode: the API serves unauthenticated reads, password sign-up is open (so
# a throwaway account can be created for screenshots with no invite), and there is no
# GitHub/GitLab PAT — repo-operating agent steps are out of scope for doc capture.
AUTH_DEV_OPEN=true
AUTH_PASSWORD_ENABLED=true
AUTH_OPEN_SIGNUP=true

# Don't try to pull/refresh the executor-harness image at boot: we never launch agent
# job containers here, and skipping the pull keeps boot fast and offline-friendly.
LOCAL_HARNESS_IMAGE_REFRESH=off

# Filled in by scripts/start.mjs (base64/hex, 32 bytes each). Must stay stable across
# restarts or sessions/encrypted config are invalidated.
AUTH_SESSION_SECRET=
ENCRYPTION_KEY=
