{
  "name": "cat-factory-website",
  "version": "1.0.0",
  "description": "Documentation site for Cat Factory — the software development agent management platform.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "docs:clean-dev": "vuepress dev docs --clean-cache",
    "docs:preview": "vuepress build docs && vuepress dev docs",
    "docs:images": "node scripts/optimize-images.mjs",
    "docs:env-vars": "node scripts/sync-env-vars.mjs",
    "docs:env-vars:check": "node scripts/sync-env-vars.mjs --check",
    "docs:env-vars:verify": "node scripts/sync-env-vars.mjs --verify",
    "docs:openapi": "node scripts/sync-openapi.mjs",
    "docs:openapi:check": "node scripts/sync-openapi.mjs --check",
    "docs:openapi:verify": "node scripts/sync-openapi.mjs --verify",
    "docs:repo-links": "node scripts/check-repo-links.mjs"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-redirect": "2.0.0-rc.131",
    "@vuepress/plugin-search": "2.0.0-rc.131",
    "@vuepress/theme-default": "2.0.0-rc.132",
    "sass-embedded": "^1.102.0",
    "sharp": "^0.35.3",
    "vue": "^3.5.41",
    "vuepress": "2.0.0-rc.30"
  }
